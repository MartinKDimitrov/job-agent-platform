# Copy to .env and fill in.
# Staging Postgres is reached through an SSH tunnel on local port 5433:
#   ssh -i <key> -N -L 5433:localhost:5432 root@<staging-host>
# (5432 is usually taken by a local Postgres — use 5433 to avoid the clash.)
DATABASE_URL=postgresql+psycopg2://jobagent:CHANGE_ME@localhost:5433/jobagent
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=10080

# Google OAuth (optional for Phase 1 — email+password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# Embeddings
E5_MODEL=intfloat/multilingual-e5-small
